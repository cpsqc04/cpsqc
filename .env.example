# Copy to .env and fill in real values for production.
# Never commit real secrets.

# Database (local)
DB_HOST_LOCAL=localhost
DB_NAME_LOCAL=LGU
DB_USER_LOCAL=root
DB_PASS_LOCAL=
DB_PORT_LOCAL=3306

ENVIRONMENT=auto

# Partner API keys (inbound)
PATROL_REQUEST_API_KEY=change-me-patrol
CCTV_REQUEST_API_KEY=change-me-cctv
AWARENESS_EVENTS_API_KEY=change-me-awareness
CRIME_ANALYTICS_API_KEY=change-me-crime-analytics

# Incident Reporting (Digital Blotter / tips / CCTV evidence)
# Legacy aliases still work: BLOTTER_API_KEY, BLOTTER_API_URL, TIP_BLOTTER_API_URL, BLOTTER_API_TIMEOUT
INCIDENT_REPORTING_API_KEY=change-me-incident-reporting
INCIDENT_REPORTING_API_URL=https://partner-incident-reporting.example.com/api/blotter/receive
INCIDENT_REPORTING_TIP_API_URL=https://partner-incident-reporting.example.com/api/tip/receive
INCIDENT_REPORTING_API_TIMEOUT=30

# Emergency Response (police backup)
# Legacy aliases still work: GROUP3_API_KEY, GROUP3_API_URL, GROUP3_API_TIMEOUT
EMERGENCY_RESPONSE_API_KEY=change-me-emergency-response
EMERGENCY_RESPONSE_API_URL=https://partner-emergency-response.example.com/api/coordination/receive
EMERGENCY_RESPONSE_API_TIMEOUT=30
