# Copy to .env and fill in real values for production.
# Never commit real secrets.

# Database (local)
DB_HOST_LOCAL=localhost
DB_NAME_LOCAL=LGU
DB_USER_LOCAL=root
DB_PASS_LOCAL=
DB_PORT_LOCAL=3306

# Database (production Hostinger)
DB_HOST_PROD=localhost
DB_NAME_PROD=
DB_USER_PROD=
DB_PASS_PROD=
DB_PORT_PROD=3306

# Set to production on the live server (disables Python/YOLO on Hostinger — prevents high CPU)
ENVIRONMENT=auto

# --- CCTV live feed (Hostinger + on-site PC on same router LAN) ---
# Production Hostinger .env: set a long random key only (no Python on server).
# On-site PC .env: same key + upload URL pointing to production.
CCTV_FRAME_UPLOAD_KEY=change-me-long-random-upload-key
# On-site PC only (leave empty on Hostinger):
# CCTV_FRAME_UPLOAD_URL=https://surveillance.alertaraqc.com/api/cctv_frame_upload.php
# CCTV_RECORDING_UPLOAD_URL=https://surveillance.alertaraqc.com/api/cctv_recording_upload.php
#   (optional — defaults from CCTV_FRAME_UPLOAD_URL if omitted)
# CCTV_CAMERAS_CONFIG_URL=https://surveillance.alertaraqc.com/api/cctv_cameras_config.php
# LAN / upload quality. Options: vlc | lan | balanced | hostinger
# Prefer vlc/lan on the on-site PC for near-VLC clarity; keep sub-stream for OpenCV stability.
# Auto-detect Reolink GetEnc and sync stream type + JPEG relay quality (default true).
# CCTV_AUTO_ENCODING=true
# CCTV_FEED_QUALITY=vlc
# CCTV_USE_MAIN_STREAM=false
# CCTV_UPLOAD_MIN_INTERVAL=0.08
# CCTV_UPLOAD_JPEG_QUALITY=95
# CCTV_UPLOAD_MAX_WIDTH=1920
# Hostinger may optionally allow larger / faster uploads:
# CCTV_UPLOAD_SERVER_MIN_INTERVAL=0.08
# CCTV_UPLOAD_MAX_BYTES=5000000
# Never set true on Hostinger shared hosting (causes high CPU / 504 errors):
# CCTV_DETECTION_ON_SERVER=false
# On-site PC: run start_detection_agent.bat once — keeps detect.py running 24/7,
# starts go2rtc for near-Reolink-app WebRTC live view, and runs camera LAN scans.
# CCTV_VIEWER_STATUS_URL=https://surveillance.alertaraqc.com/api/cctv_viewer_status.php
# CCTV_CAMERA_SCAN_URL=https://surveillance.alertaraqc.com/api/cctv_camera_scan.php
# CCTV_ENCODING_SYNC_URL=https://surveillance.alertaraqc.com/api/cctv_encoding_sync.php
# CCTV_WEBRTC_STATUS_URL=https://surveillance.alertaraqc.com/api/cctv_webrtc_status.php
# Low-latency live view (go2rtc). Local default: http://127.0.0.1:1984
# Uses zero-copy camera RTSP (no ffmpeg) so delay matches the Reolink app.
# Auto HTTPS tunnel (cloudflared) embeds live view inside Hostinger Open Surveillance.
# CCTV_WEBRTC_TUNNEL=true
# For a stable custom domain instead of trycloudflare.com:
# CCTV_WEBRTC_PUBLIC_URL=https://your-go2rtc-tunnel.example.com
# Only enable if browsers fail to play H.265 (adds delay):
# CCTV_WEBRTC_TRANSCODE=false
# CCTV_GO2RTC_LISTEN=:1984
# CCTV_AGENT_POLL_SECONDS=3
# CCTV_VIEWER_ACTIVE_SECONDS=90

MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@alertaraqc.com
MAIL_FROM_NAME="AlerTaraQC"
MAIL_DEBUG=false

# --- Partner outbound keys (AlertaraQC → partners) ---
# Inbound partner receive/list APIs on AlertaraQC are public (no key).
# Keys below are still used when AlertaraQC calls partner systems.

# --- Incident Reporting (Digital Blotter / tips / CCTV evidence) ---
# Live catalog (read-only dump): https://report.alertaraqc.com/api/api.php?action=all
# Live modules list: https://report.alertaraqc.com/api/api.php?action=modules
# Confirmed write action today: create_blotter (requires complainant_name + incident_type)
# Legacy aliases still work: BLOTTER_API_KEY, BLOTTER_API_URL, TIP_BLOTTER_API_URL, BLOTTER_API_TIMEOUT
INCIDENT_REPORTING_API_KEY=
INCIDENT_REPORTING_API_URL=https://report.alertaraqc.com/api/api.php?action=create_blotter
# Tips: IR has no dedicated tip write action yet — log via create_blotter with incident_type=Community Tip
INCIDENT_REPORTING_TIP_API_URL=https://report.alertaraqc.com/api/api.php?action=create_blotter
# CCTV evidence return: set only when IR publishes a dedicated receive action (do NOT use create_blotter)
# Local stub: http://localhost/cpsqc-main/api/cctv_evidence_receive.php
# CCTV_EVIDENCE_API_URL=
INCIDENT_REPORTING_API_TIMEOUT=30

# --- Emergency Response (tip receive / police backup) ---
# Legacy aliases still work: GROUP3_API_KEY, GROUP3_API_URL, GROUP3_API_TIMEOUT
# Payload includes tip_id for anonymous_tip.php-style APIs.
EMERGENCY_RESPONSE_API_KEY=change-me-emergency-response
EMERGENCY_RESPONSE_API_URL=https://emergency-response.alertaraqc.com/api/system_API/anonymous_tip.php
EMERGENCY_RESPONSE_API_TIMEOUT=30

# --- Crime Analytics (high-risk alerts) ---
# AlertaraQC pulls their public active feed for Patrol Schedule → High-Risk Areas.
# Push receive endpoint still works: POST /api/crime_analytics_alerts_receive.php
CRIME_ANALYTICS_ACTIVE_DATA_URL=https://crime-analytics.alertaraqc.com/alerts/api/active-data
# CRIME_ANALYTICS_API_KEY=  (optional; their active-data feed is public)
CRIME_ANALYTICS_API_TIMEOUT=20

# --- Campaign (youth / sports / cultural recommendations from patrol reports) ---
# AlertaraQC → Campaign. Until they publish a live receive URL, point at the local stub:
CAMPAIGN_RECOMMENDATION_API_URL=http://localhost/cpsqc-main/api/campaign_recommendation_receive.php
# CAMPAIGN_API_KEY=
CAMPAIGN_API_TIMEOUT=30
